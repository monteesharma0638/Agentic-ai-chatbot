{
  "name": "@mf-chat/mcp-server",
  "version": "1.0.0",
  "private": true,
  "description": "MCP server exposing Indian mutual fund data (AMFI / mfapi.in) and analytics tools",
  "type": "module",
  "exports": {
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "bin": {
    "india-mf-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --watch --import tsx src/index.ts --http",
    "start": "node dist/index.js --http",
    "start:stdio": "node dist/index.js --stdio",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js --stdio",
    "smoke": "tsx scripts/smoke.ts"
  },
  "engines": {
    "node": ">=20.12"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "express": "^5.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6"
  }
}
