# HTTP mode (npm start / npm run dev). Use 0.0.0.0 inside Docker.
MCP_HOST=127.0.0.1
MCP_PORT=3100
# Require "Authorization: Bearer <token>" on /mcp (set the same value in agent-service/.env).
MCP_AUTH_TOKEN=
# Leave EMPTY for local development. Only when MCP_HOST=0.0.0.0 (Docker/server), list the
# hostnames clients use to reach this server, e.g. "mcp,localhost". Not an IP to bind to.
MCP_ALLOWED_HOSTS=

# Analytics
RISK_FREE_RATE_PCT=6.5
# Benchmark proxy for beta/alpha: UTI Nifty 50 Index Fund - Direct Growth
BENCHMARK_SCHEME_CODE=120716
RANK_MAX_SCHEMES=80

# Data sources and caching
MFAPI_BASE_URL=https://api.mfapi.in
AMFI_NAV_URL=https://www.amfiindia.com/spages/NAVAll.txt
AMFI_CACHE_TTL_MIN=180
HISTORY_CACHE_TTL_MIN=60
HISTORY_CACHE_SIZE=400
HTTP_TIMEOUT_MS=20000
