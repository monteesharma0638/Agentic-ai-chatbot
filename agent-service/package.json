{
  "name": "@mf-chat/agent-service",
  "version": "1.0.0",
  "private": true,
  "description": "Gemini-powered agentic chat API for mutual funds, using MCP tools",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --watch --import tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "token": "node scripts/token.mjs"
  },
  "engines": {
    "node": ">=20.12"
  },
  "dependencies": {
    "@google/genai": "^2.24.0",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@vercel/functions": "^3.9.9",
    "express": "^5.2.1",
    "ioredis": "^6.0.0",
    "mysql2": "^3.24.4",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "pino-pretty": "^13.1.3"
  }
}
