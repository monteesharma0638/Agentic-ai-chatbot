# ---------- Server ----------
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
# Behind nginx / a load balancer set to 1 so rate limits see real client IPs.
TRUST_PROXY=loopback

# ---------- Gemini ----------
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Flash-Lite is the fastest (~1 s per step) and has the most free-tier quota.
GEMINI_MODEL=gemini-3.5-flash-lite
# Tried in order when a model is overloaded (503), out of quota (429), unavailable or stalls.
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.8-flash
# minimal | low | medium | high  (lower = faster & cheaper). Leave empty for the model default.
GEMINI_THINKING_LEVEL=low
GEMINI_MAX_OUTPUT_TOKENS=2048
# Give up on a model that sends nothing for this long, and switch to the next one.
MODEL_STALL_TIMEOUT_MS=20000
# A model that just failed is tried last for this many seconds.
MODEL_COOLDOWN_SECONDS=60

# ---------- Website / widget access ----------
# Same value as MF_CHAT_SECRET in your Laravel .env (min 32 chars). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WIDGET_TOKEN_SECRET=
# Let logged-out visitors chat (identified by a random per-browser id).
ALLOW_ANONYMOUS=false
# Comma-separated origins of the website(s) embedding the widget.
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
# Dev-only test page at /playground (mints test tokens). Must be false in production.
ENABLE_PLAYGROUND=true

# ---------- MCP data server ----------
# Used by mcp.config.json
MF_MCP_URL=http://127.0.0.1:3100/mcp
MCP_AUTH_TOKEN=
MCP_CONFIG=mcp.config.json

# ---------- Agent behaviour ----------
APP_NAME=MF Invest
ASSISTANT_NAME=Fundy
AGENT_MAX_STEPS=8
TOOL_TIMEOUT_MS=45000
HISTORY_MAX_TURNS=12
HISTORY_FULL_TURNS=2
MAX_MESSAGE_CHARS=2000
RATE_LIMIT_PER_MINUTE=20
RATE_LIMIT_PER_IP_PER_MINUTE=60

# ---------- Conversation storage ----------
# auto = Redis if REDIS_URL is set, Vercel Runtime Cache on Vercel, otherwise in-memory.
CONVERSATION_STORE=auto
# Empty = no Redis. Set it to keep conversations across restarts / instances.
REDIS_URL=
CONVERSATION_TTL_HOURS=24

# ---------- "My portfolio" questions ----------
# none | demo | mysql
PORTFOLIO_SOURCE=demo
# Read-only DB user on your Laravel database.
PORTFOLIO_DB_URL=mysql://mfchat_readonly:change-me@127.0.0.1:3306/laravel
# Must return scheme_code, units, invested_amount. :user_id = the logged-in user's id.
PORTFOLIO_HOLDINGS_SQL="SELECT scheme_code, units, invested_amount FROM holdings WHERE user_id = :user_id AND units > 0"
# Optional, enables XIRR. Must return scheme_code, date (YYYY-MM-DD), amount (negative = redemption).
PORTFOLIO_TRANSACTIONS_SQL=
