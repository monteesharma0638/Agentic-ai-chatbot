# ---------- Server ----------
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
# Behind nginx / a load balancer set to 1 so rate limits see real client IPs.
TRUST_PROXY=loopback

# ---------- Gemini ----------
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Flash-Lite is the fastest (~1 s per step) and has the most free-tier quota.
GEMINI_MODEL=gemini-3.5-flash-lite
# Tried in order when a model is overloaded (503), out of quota (429), unavailable or stalls.
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.8-flash
# minimal | low | medium | high  (lower = faster & cheaper). Leave empty for the model default.
GEMINI_THINKING_LEVEL=low
GEMINI_MAX_OUTPUT_TOKENS=2048
# Give up on a model that sends nothing for this long, and switch to the next one.
MODEL_STALL_TIMEOUT_MS=20000
# A model that just failed is tried last for this many seconds.
MODEL_COOLDOWN_SECONDS=60

# ---------- Website / widget access ----------
# Shared secret used to VERIFY the JWT (HS256) your website signs and passes to the widget. Must be the
# exact same value your website signs tokens with (min 32 chars). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The user id is read from the token's `sub` claim (or, for Robo Rupee tokens, the nested `user_id.user_id`);
# `name` and `risk` are optional. To use the same Robo Rupee login for the holdings API (PORTFOLIO_SOURCE=roborupee),
# set this to Robo Rupee's own JWT signing secret so one token serves both chat identity and the holdings call.
WIDGET_TOKEN_SECRET=
# Let logged-out visitors chat (identified by a random per-browser id).
ALLOW_ANONYMOUS=false
# Comma-separated origins of the website(s) embedding the widget.
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
# Test page at /playground (can create test logins for any user id). Turn off before a public launch.
ENABLE_PLAYGROUND=true
# Optional browser login for /playground (any username, 12+ characters). Recommended before any public launch.
PLAYGROUND_PASSWORD=
# Dev-only: a ready-made user JWT (e.g. a real host-app / Robo Rupee token). When set, /playground signs in as
# this exact user and the identity layer trusts it verbatim (no signature check), so you can test real holdings
# without putting the host's JWT secret here. IGNORED in production — never set it there.
PLAYGROUND_USER_TOKEN=

# ---------- MCP data server ----------
# Used by mcp.config.json
MF_MCP_URL=http://127.0.0.1:3100/mcp
MCP_AUTH_TOKEN=
MCP_CONFIG=mcp.config.json

# ---------- Agent behaviour ----------
APP_NAME=MF Invest
ASSISTANT_NAME=Fundy
AGENT_MAX_STEPS=8
TOOL_TIMEOUT_MS=45000
HISTORY_MAX_TURNS=12
HISTORY_FULL_TURNS=2
MAX_MESSAGE_CHARS=2000
# Largest chat request body in MB (a message may carry an attached image/PDF). Keep under the host cap (Vercel ~4.5 MB).
MAX_UPLOAD_MB=6
RATE_LIMIT_PER_MINUTE=20
RATE_LIMIT_PER_IP_PER_MINUTE=60

# ---------- Storage (MongoDB) ----------
# All chats and token usage are stored here, keyed by the user id from the JWT. Required in production.
# Leave empty for local dev/tests to use an in-memory store (lost on restart, single instance only).
MONGODB_URI=
MONGODB_DB=mfchat

# ---------- AI usage limits ----------
# Per-user token budget per rolling window. 0 = no limit (usage is still recorded, never blocked).
USAGE_LIMIT_TOKENS=0
USAGE_WINDOW_HOURS=24

# ---------- Server-to-server API ----------
# Lets another backend read a user's chats/usage via GET /internal/... with header `X-Api-Key: <this>`.
# Leave empty to disable those routes. Min 16 chars. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
SERVICE_API_KEY=

# ---------- "My portfolio" questions ----------
# none = disabled | demo = built-in sample holdings (for local testing) | roborupee = live holdings from the
# Robo Rupee admin API, valued at the latest AMFI NAV by ISIN.
PORTFOLIO_SOURCE=demo
# Robo Rupee holdings API (only when PORTFOLIO_SOURCE=roborupee). The customer is taken from the user's own
# JWT, which the chat server forwards — so WIDGET_TOKEN_SECRET must be Robo Rupee's JWT secret (see above).
ROBORUPEE_API_URL=https://admin.roborupee.com
ROBORUPEE_HOLDINGS_PATH=/api/holdings/get
ROBORUPEE_TIMEOUT_MS=10000
# Optional single fixed token, used ONLY for local/single-tenant testing when no per-user token is forwarded.
# Leave EMPTY in production: a shared token would return one customer's holdings to every user.
ROBORUPEE_API_TOKEN=
